{
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},
	"AllowedHosts": "*",
	"LibraryPolicy": {
		"MembershipDurationMonths": 12,
		"LoanPeriodDays": 14,
		"MaxActiveLoansPerMember": 5,
		"MaxRenewals": 2,
		"DailyFineAmount": 5,
		"MaxFinePerLoan": 200
	},
	"Jwt": {
		"Issuer": "LibraryManagementSystemAPI",
		"Audience": "LibraryManagementSystemClients",
		"AccessTokenMinutes": 15,
		"RefreshTokenDays": 14
	},
	"RateLimiting": {
		"Auth": {
			"PermitLimit": 5,
			"WindowSeconds": 60
		}
	}
}